# GitHub token: github.com/settings/tokens -> "Fine-grained", read-only access to public repositories is enough.
GITHUB_TOKEN=
# Domain the cards are served from (DNS A record must point to this server).
DOMAIN=cards.example.com
# Optional: serve only these accounts (comma separated). Empty = anyone.
ALLOWED_USERS=
# How long GitHub data is cached, in hours.
CACHE_HOURS=2
