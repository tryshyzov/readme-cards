# Example nginx site for running behind an existing nginx.
# Copy to /etc/nginx/sites-available/cards.example.com, link into sites-enabled, then: nginx -t && systemctl reload nginx
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name cards.example.com;

    ssl_certificate     /path/to/fullchain.pem;
    ssl_certificate_key /path/to/key.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    access_log /var/log/nginx/cards.access.log;
    error_log  /var/log/nginx/cards.error.log;
}
